{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hermes/pont-001-grok-review-v1.json",
  "title": "HERMES-PT-PONT-001 Grok review batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "domain",
          "truth",
          "structural_region",
          "expected_diagnostics",
          "rationale",
          "confidence",
          "requires_human",
          "critical_reason"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "domain": {
            "enum": [
              "operations",
              "maintenance",
              "software",
              "infrastructure",
              "safety",
              "support",
              "other"
            ]
          },
          "truth": {
            "enum": ["violation", "non_violation", "out_of_scope", "ambiguous"]
          },
          "structural_region": {
            "enum": [
              "visible_prose",
              "fenced_code",
              "inline_code",
              "link_destination_or_url",
              "metadata",
              "markup_or_attribute",
              "document_control",
              "ambiguous"
            ]
          },
          "expected_diagnostics": {"type": ["integer", "null"], "enum": [0, 1, null]},
          "rationale": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["high", "medium", "low"]},
          "requires_human": {"type": "boolean"},
          "critical_reason": {
            "enum": [
              "none",
              "insufficient_context",
              "malformed_markup",
              "mixed_region",
              "provenance_or_license",
              "protocol_gap",
              "reviewer_uncertain"
            ]
          }
        }
      }
    }
  }
}
